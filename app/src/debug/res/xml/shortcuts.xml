<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidDomInspection -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.metrolist.music.action.SEARCH"
            android:targetClass="com.metrolist.music.MainActivity"
            android:targetPackage="com.cabrata.utaloom.android.debug" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_favorite"
        android:shortcutId="liked"
        android:shortcutShortLabel="@string/liked_songs">
        <intent
            android:action="com.metrolist.music.action.OPEN_WIDGET_TARGET"
            android:targetClass="com.metrolist.music.MainActivity"
            android:targetPackage="com.cabrata.utaloom.android.debug">
            <extra android:name="widget_target_type" android:value="liked" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_download"
        android:shortcutId="downloaded"
        android:shortcutShortLabel="@string/downloaded_songs">
        <intent
            android:action="com.metrolist.music.action.OPEN_WIDGET_TARGET"
            android:targetClass="com.metrolist.music.MainActivity"
            android:targetPackage="com.cabrata.utaloom.android.debug">
            <extra android:name="widget_target_type" android:value="downloaded" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_mic"
        android:shortcutId="recognize"
        android:shortcutShortLabel="@string/recognize_music">
        <intent
            android:action="com.metrolist.music.action.RECOGNITION"
            android:targetClass="com.metrolist.music.MainActivity"
            android:targetPackage="com.cabrata.utaloom.android.debug">
            <extra android:name="auto_start_recognition" android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_library"
        android:shortcutId="library"
        android:shortcutShortLabel="@string/filter_library">
        <intent
            android:action="com.metrolist.music.action.LIBRARY"
            android:targetClass="com.metrolist.music.MainActivity"
            android:targetPackage="com.cabrata.utaloom.android.debug" />
    </shortcut>
</shortcuts>
